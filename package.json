{
  "name": "@vijayhardaha/video2pdf",
  "version": "1.0.5",
  "type": "module",
  "description": "A CLI tool to convert video files to PDF by extracting frames using FFmpeg.",
  "scripts": {
    "build": "vite build",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write --log-level error .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "tsc": "tsc --noEmit",
    "release": "release-it",
    "release:dry": "release-it --dry-run",
    "prepare": "husky"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "main": "dist/index.cjs",
  "bin": {
    "video2pdf": "dist/index.cjs"
  },
  "license": "MIT",
  "author": {
    "name": "Vijay Hardaha",
    "url": "https://github.com/vijayhardaha"
  },
  "homepage": "https://github.com/vijayhardaha/video2pdf-cli#readme",
  "bugs": {
    "url": "https://github.com/vijayhardaha/video2pdf-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vijayhardaha/video2pdf-cli.git"
  },
  "keywords": [
    "video2pdf",
    "video-to-pdf",
    "img2pdf",
    "image2pdf",
    "image-to-pdf",
    "Video To PDF CLI",
    "ffmpeg",
    "cli",
    "typescript"
  ],
  "dependencies": {
    "commander": "^15.0.0",
    "ffmpeg-static": "^5.3.0",
    "image-to-pdf": "^3.0.2",
    "ora": "^9.4.1",
    "slugify": "^1.6.9"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/types": "^21.2.0",
    "@eslint/compat": "^2.1.0",
    "@prettier/plugin-xml": "^3.4.2",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vijayhardaha/dev-config": "^2.3.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^64.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "release-it": "^21.0.2",
    "rollup": "^4.62.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "trustedDependencies": [
    "ffmpeg-static",
    "unrs-resolver"
  ]
}
