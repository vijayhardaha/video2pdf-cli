{
  "name": "@vijayhardaha/video2pdf",
  "version": "1.0.4",
  "description": "A CLI tool to convert video files to PDF by extracting frames using FFmpeg.",
  "scripts": {
    "build": "vite build",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write --log-level error .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "tsc": "tsc --noEmit",
    "release": "release-it",
    "release:dry": "release-it --dry-run",
    "prepare": "husky"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "main": "dist/index.js",
  "bin": {
    "video2pdf": "dist/index.js"
  },
  "license": "MIT",
  "author": {
    "name": "Vijay Hardaha",
    "url": "https://github.com/vijayhardaha"
  },
  "homepage": "https://github.com/vijayhardaha/video2pdf-cli#readme",
  "bugs": {
    "url": "https://github.com/vijayhardaha/video2pdf-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vijayhardaha/video2pdf-cli.git"
  },
  "keywords": [
    "video2pdf",
    "video-to-pdf",
    "img2pdf",
    "image2pdf",
    "image-to-pdf",
    "Video To PDF CLI",
    "ffmpeg",
    "cli",
    "typescript"
  ],
  "dependencies": {
    "commander": "^15.0.0",
    "ffmpeg-static": "^5.3.0",
    "image-to-pdf": "^3.0.2",
    "ora": "^9.4.0",
    "slugify": "^1.6.9"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@commitlint/types": "^21.0.1",
    "@eslint/compat": "^2.1.0",
    "@prettier/plugin-xml": "^3.4.2",
    "@types/node": "^25.9.2",
    "@vijayhardaha/dev-config": "^2.1.0",
    "@vitest/coverage-v8": "^4.1.8",
    "@vitest/ui": "^4.1.8",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jsdoc": "^63.0.2",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.4",
    "release-it": "^20.2.0",
    "rollup": "^4.61.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "trustedDependencies": [
    "ffmpeg-static",
    "unrs-resolver"
  ]
}
